{
  "openapi": "3.0.1",
  "info": {
    "title": "Inventory Service API",
    "description": "Stock management, saga reserve/confirm/release, product event auto-initialisation",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8083/api/v1",
      "description": "Generated server url"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Inventory",
      "description": "Stock level management and availability checks"
    }
  ],
  "paths": {
    "/inventory/{productId}": {
      "get": {
        "tags": [
          "Inventory"
        ],
        "summary": "Get stock levels",
        "description": "Returns current available and reserved quantities for a product.",
        "operationId": "getStock",
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "description": "Product UUID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "401": {
            "description": "Not authenticated",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "200": {
            "description": "Stock levels returned",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/StockResponse"
                }
              }
            }
          },
          "404": {
            "description": "No stock record for this product",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "put": {
        "tags": [
          "Inventory"
        ],
        "summary": "Restock a product (Admin)",
        "description": "Adds the given quantity to the product's available stock. Creates the stock record if it does not yet exist. Requires ROLE_ADMIN.",
        "operationId": "restock",
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "description": "Product UUID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StockUpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Stock updated",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/StockResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Concurrent update conflict after retries",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient role",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/inventory/{productId}/availability": {
      "get": {
        "tags": [
          "Inventory"
        ],
        "summary": "Check stock availability",
        "description": "Returns whether the requested quantity is currently available. Used internally by Cart Service via Feign — no auth header required from within the Docker network.",
        "operationId": "checkAvailability",
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "description": "Product UUID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "qty",
            "in": "query",
            "description": "Requested quantity (must be \u003E= 1)",
            "required": true,
            "schema": {
              "minimum": 1,
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Availability result",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AvailabilityResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "StockUpdateRequest": {
        "required": [
          "quantity"
        ],
        "type": "object",
        "properties": {
          "quantity": {
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "StockResponse": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "availableQty": {
            "type": "integer",
            "format": "int32"
          },
          "reservedQty": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          },
          "fieldErrors": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "AvailabilityResponse": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "available": {
            "type": "boolean"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "name": "bearerAuth",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}